+        except Exception as e:
+            if attempt < max_retries - 1:
+                wait = 2 ** attempt
+                print(f"  Gemini API error: {e}. Retrying in {wait}s...")
+                time.sleep(wait)
+            else:
+                print(f"  Gemini API failed after {max_retries} attempts: {e}")
